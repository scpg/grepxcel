# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Python bytecode & caches ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── Build / packaging ─────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
pip-wheel-metadata/

# ── Runtime output (directory kept in repo via .gitkeep) ─────────────────────
output/*
!output/.gitkeep

# ── Logs — ignored everywhere (CLI creates the dir at runtime via os.makedirs) ─
**/logs/

# ── Wizard-generated pattern files (timestamped, never committed) ─────────────
*-wizard-*.xlsx
*-wizard-*.csv

# ── Environment / secrets ─────────────────────────────────────────────────────
.env*
!.env.example
!.env.template
.envrc*
!.envrc.example
!.envrc.template
*.log

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Knowledge graph build output (graphify, local only) ──────────────────────
graphify-out/

# ── Drafter output / failed runs (local only) ────────────────────────────────
draft_pattern.xlsx
draft_pattern_FAILED.txt

# ── Throwaway scripts (ad-hoc, never synced) ─────────────────────────────────
tmp.local/

# ── Local-only sample files (never synced) ───────────────────────────────────
samples.local/

# ── Claude Code local settings ────────────────────────────────────────────────
.claude/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Office lock files ─────────────────────────────────────────────────────────
~$*
.~lock.*#
marketing.local/
