# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Python bytecode & caches ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── Build / packaging ─────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
pip-wheel-metadata/

# ── Runtime output (directories kept in repo via .gitkeep) ───────────────────
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep

# ── Wizard logs created inside fixture/sample dirs (never committed) ──────────
tests/fixtures/**/logs/
samples.local/**/logs/

# ── Wizard-generated pattern files (timestamped, never committed) ─────────────
*-wizard-*.xlsx
*-wizard-*.csv

# ── Environment / secrets ─────────────────────────────────────────────────────
.env*
!.env.example
!.env.template
.envrc*
!.envrc.example
!.envrc.template
*.log

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Throwaway scripts (ad-hoc, never synced) ─────────────────────────────────
tmp.local/

# ── Local-only sample files (never synced) ───────────────────────────────────
samples.local/

# ── Claude Code local settings ────────────────────────────────────────────────
.claude/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Office lock files ─────────────────────────────────────────────────────────
~$*
.~lock.*#
