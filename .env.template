# Extended environment template — for 1Password / Snyk CI workflows.
# Includes Snyk org variables and optional maintainer keys.
# Use with: op run --env-file=.env  (1Password CLI)
#
# For a simpler setup (no Snyk, no 1Password), use .env.example instead.
# .env is gitignored — never commit real keys.

# ── Core: cloud LLM backends ─────────────────────────────────────────────────

# Anthropic Claude — get yours at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — get yours at https://aistudio.google.com → Get API key
GOOGLE_API_KEY=AIza...

# GitHub — get yours at https://github.com/settings/tokens → Personal Access Tokens
GITHUB_TOKEN=github_pat_...

# ── Snyk (CI security scanning) ──────────────────────────────────────────────

SNYK_ORGANIZATION_SLUG=
SNYK_ORGANIZATION_ID=
SNYK_PROJECT_ID=

# ── Maintainer-only (not needed by contributors) ─────────────────────────────

# ElevenLabs — AI narration for demo videos
# Get yours at https://elevenlabs.io/developers → API Keys
ELEVENLABS_API_KEY=sk_...
